# Supabase (create project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — used by API routes for uploads and analytics (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: AI narrative for demand planning (server-side only)
OPENAI_API_KEY=sk-...
NEXT_PUBLIC_OPENAI_ENABLED=true
