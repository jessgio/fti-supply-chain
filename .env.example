# Supabase (create project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — used by API routes for uploads and analytics (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: AI narrative for demand planning + extract screenshot OCR (server-side only)
OPENAI_API_KEY=sk-...
NEXT_PUBLIC_OPENAI_ENABLED=true
# Use an OpenAI-compatible gateway (e.g. OpenRouter). With an OpenRouter key
# (sk-or-...) this defaults to https://openrouter.ai/api/v1 automatically.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Vision model for extract screenshot parsing (default gpt-4o; auto-prefixed
# with "openai/" when routing through OpenRouter).
# OPENAI_VISION_MODEL=gpt-4o

# Optional: Lark group bot alerts (low stock, stockout risk, upcoming shipments)
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-hook-id
LARK_WEBHOOK_SECRET=your-signing-secret
# Protects /api/cron/stock-alerts (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string
# Public app URL for links inside Lark messages (falls back to VERCEL_URL on Vercel)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Optional alert thresholds (defaults: 30 days stockout, 14 days shipments)
# LARK_ALERT_STOCKOUT_DAYS=30
# LARK_ALERT_SHIPMENT_DAYS=14

# Lark Approval (AP Form / 应付单) — same app as fti-finance-dashboard
LARK_APP_ID=cli_xxxxxxxx
LARK_APP_SECRET=your_app_secret
LARK_APPROVAL_CODE=B46B01D3-A7E7-4B56-B685-D796327B0B9D
# Optional: comma-separated open_ids pre-selected as AP Form approvers
# (also settable per person on the Lark users page)
# LARK_DEFAULT_APPROVER_OPEN_IDS=ou_xxxxxxxx,ou_yyyyyyyy
# LARK_DEFAULT_APPROVER_OPEN_ID=ou_xxxxxxxx
# LARK_BASE_URL=https://open.larksuite.com
# Optional override for approval file upload host (default: https://www.larksuite.com)
# LARK_APPROVAL_FILE_BASE_URL=https://www.larksuite.com
